<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_marginBottom="8dp"
    android:padding="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_search">

    <ImageView
        android:id="@+id/imgSearchProduct"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:scaleType="centerCrop"
        android:contentDescription="Ảnh vật phẩm" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtSearchProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sách tiếng Anh"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#222822"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtSearchProductStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_filter_selected"
            android:text="Còn khả dụng"
            android:textSize="10sp"
            android:textColor="#287C32" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/placeholder"
                android:contentDescription="Địa chỉ" />

            <TextView
                android:id="@+id/txtSearchProductInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Địa chỉ · 1 giờ trước"
                android:textSize="11sp"
                android:textColor="#777777"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
