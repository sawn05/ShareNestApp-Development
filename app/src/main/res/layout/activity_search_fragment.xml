<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#247B53">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            app:tint="#ffffff"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Tìm kiếm"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- SEARCH BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search"
            android:paddingStart="12dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/search_icon"
                android:contentDescription="Tìm kiếm" />

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Tìm nhu yếu phẩm..."
                android:singleLine="true"
                android:inputType="text"
                android:textSize="13sp"
                android:textColor="#222222"
                android:textColorHint="#8A8F8A" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnFilter"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_search"
            android:src="@drawable/hamburger"
            android:contentDescription="Bộ lọc" />
    </LinearLayout>

    <!-- LOCATION -->
    <LinearLayout
        android:id="@+id/btnSearchLocation"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/placeholder"
            android:contentDescription="Vị trí" />

        <TextView
            android:id="@+id/txtSearchLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Khu vực: Chưa chọn"
            android:textSize="12sp"
            android:textColor="#737A73" />

        <ImageView
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/mui_ten_1"
            android:rotation="90"
            android:contentDescription="Chọn khu vực" />
    </LinearLayout>

    <!-- SORT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingStart="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sắp xếp:"
            android:textSize="12sp"
            android:textColor="#737A73" />

        <TextView
            android:id="@+id/btnSortNearest"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center"
            android:background="@drawable/bg_filter_selected"
            android:text="Gần nhất"
            android:textSize="12sp"
            android:textColor="#287C32" />

        <TextView
            android:id="@+id/btnSortNewest"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center"
            android:background="@drawable/bg_search"
            android:text="Mới nhất"
            android:textSize="12sp"
            android:textColor="#737A73" />
    </LinearLayout>

    <!-- CATEGORY CHIPS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- PRODUCT LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/txtSearchEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center"
        android:text="Không tìm thấy vật phẩm phù hợp"
        android:textColor="#777777"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingBottom="14dp"
        android:text="Khoảng cách được ước tính từ vị trí gần đúng."
        android:textSize="11sp"
        android:textColor="#808780" />

</LinearLayout>
